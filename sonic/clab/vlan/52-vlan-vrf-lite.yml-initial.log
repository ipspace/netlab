never starts them, and has no login user) purely for operator SSH access parity\n# with the parent 'sonic' device (interactive login, 'netlab connect', ad-hoc troubleshooting) --\n# it is not part of the config-deployment path.\nset -e\nset -x\n#\n# Create bash profile script\n#\ncat <<'SCRIPT' >/root/.bash_profile\n#!/bin/bash\n#\nexport PS1=\"\\h(bash)# \"\necho \"Use vtysh to connect to FRR daemon\"\necho\nSCRIPT\n\n#\n# Build hosts file\n#\ncat <<'HOSTS' >/etc/hosts\n#\n# Created by netlab (containerlab Linux host)\n#\n127.0.0.1\tlocalhost\n::1\tlocalhost ip6-localhost ip6-loopback\nfe00::0\tip6-localnet\nff00::0\tip6-mcastprefix\nff02::1\tip6-allnodes\nff02::2\tip6-allrouters\nHOSTS\n#\ncat <<'SCRIPT' >/tmp/hosts\n#\n# Created by netlab initial\n#\n10.0.0.1 dut-a dut_a\n2001:db8:1:1::1 dut-a dut_a\n172.16.0.1 Ethernet4.red.dut_a\n2001:db8:2::1 Ethernet4.red.dut_a\n172.16.2.1 Ethernet8.red.dut_a\n2001:db8:2:2::1 Ethernet8.red.dut_a\n172.16.3.1 Ethernet12.blue.dut_a\n2001:db8:2:3::1 Ethernet12.blue.dut_a\n10.1.0.1 Ethernet0.1.blue.dut_a\n2001:db8:3::1 Ethernet0.1.blue.dut_a\n10.1.0.5 Ethernet0.2.red.dut_a\n2001:db8:3:1::1 Ethernet0.2.red.dut_a\n10.0.0.3 dut-b dut_b\n2001:db8:1:3::1 dut-b dut_b\n172.16.1.3 Ethernet4.red.dut_b\n2001:db8:2:1::3 Ethernet4.red.dut_b\n172.16.4.3 Ethernet8.blue.dut_b\n2001:db8:2:4::3 Ethernet8.blue.dut_b\n10.1.0.10 Ethernet0.1.blue.dut_b\n2001:db8:3:2::3 Ethernet0.1.blue.dut_b\n10.1.0.14 Ethernet0.2.red.dut_b\n2001:db8:3:3::3 Ethernet0.2.red.dut_b\n172.16.0.4 h1 eth1.h1\n2001:db8:2::4 h1 eth1.h1\n172.16.1.5 h2 eth1.h2\n2001:db8:2:1::5 h2 eth1.h2\n172.16.3.6 h3 eth1.h3\n2001:db8:2:3::6 h3 eth1.h3\n172.16.4.7 h4 eth1.h4\n2001:db8:2:4::7 h4 eth1.h4\n172.16.2.8 h5 eth1.h5\n2001:db8:2:2::8 h5 eth1.h5\n10.0.0.2 r2\n2001:db8:1:2::1 r2\n10.1.0.2 eth1.701.blue.r2\n2001:db8:3::2 eth1.701.blue.r2\n10.1.0.6 eth1.700.red.r2\n2001:db8:3:1::2 eth1.700.red.r2\n10.1.0.9 eth2.701.blue.r2\n2001:db8:3:2::2 eth2.701.blue.r2\n10.1.0.13 eth2.700.red.r2\n2001:db8:3:3::2 eth2.700.red.r2\nSCRIPT\ngrep \"Created by netlab\" /etc/hosts || uniq /tmp/hosts >>/etc/hosts\n#\n# Try to set hostname through Redis, wait for up to 30 seconds to succeed\n#\ntimeout 30 bash -c '\n  while ! config hostname dut-b; do\n    echo \"Waiting for redis to start\"\n    sleep 1\n  done\n'\n#\n# Enable sshd + an 'admin' user (idempotent) -- interactive access only, see note above.\n#\nid admin >/dev/null 2>&1 || useradd -m -s /bin/bash -G sudo admin\necho 'admin:YourPaSsWoRd' | chpasswd\nif which sudo; then\n  echo 'admin ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/admin\nfi\nmkdir -p /run/sshd\npgrep -x sshd >/dev/null || /usr/sbin/sshd\n#\n# Disable IPv6 (for IPv4-only interfaces) or SLAAC (if the device is a router)\n#\nconfig interface ipv6 disable use-link-local-only Ethernet0\n# Create config_db PortChannels (lag) and VLANs (vlan) before any aggregate/SVI is addressed\n# below. These live in the per-module init hooks lag/vlan sonic.initial.j2 and are pulled\n# in here, at the correct ordering point, by netlab's extra_module_initial() macro.\n#\n#\n# SONiC vlan module init: create config_db VLANs (`Vlan<id>`) before any SVI is addressed in the\n# device initial template. VNI-backed VLANs are skipped -- the vxlan module builds those on the\n# FRR/kernel bridge path, so no config_db Vlan should compete for the access ports. Pulled into\n# initial config by extra_module_initial() -- the same per-module init-hook mechanism VyOS uses.\n#\nif show vlan brief 2>/dev/null | grep -qE \"^\\|\\s+700 \"; then\n  echo Vlan700 already exists\nelse\n  config vlan add 700\nfi\nif show vlan brief 2>/dev/null | grep -qE \"^\\|\\s+701 \"; then\n  echo Vlan701 already exists\nelse\n  config vlan add 701\nfi\n\n#\n# Configure interfaces\n#\nif ip link|grep Loopback0; then\n  echo Loopback0 already exists\nelse\n  config loopback add Loopback0\nfi\nif show ip interface|grep Loopback0|grep 10.0.0.3/32; then\n  echo 10.0.0.3/32 already configured on Loopback0\nelse\n  config interface ip add Loopback0 10.0.0.3/32\nfi\nif show ipv6 interface|grep Loopback0|grep 2001:db8:1:3::1/64; then\n  echo 2001:db8:1:3::1/64 already configured on Loopback0\nelse\n  config interface ip add Loopback0 2001:db8:1:3::1/64\nfi\n!\nip link set Ethernet0 mtu 1500\n!\nif show ip interface|grep Ethernet4|grep 172.16.1.3/24; then\n  echo 172.16.1.3/24 already configured on Ethernet4\nelse\n  config interface ip add Ethernet4 172.16.1.3/24\nfi\nconfig interface ipv6 enable use-link-local-only Ethernet4\nif show ipv6 interface|grep Ethernet4|grep 2001:db8:2:1::3/64; then\n  echo 2001:db8:2:1::3/64 already configured on Ethernet4\nelse\n  config interface ip add Ethernet4 2001:db8:2:1::3/64\nfi\nip link set Ethernet4 mtu 1500\n!\nif show ip interface|grep Ethernet8|grep 172.16.4.3/24; then\n  echo 172.16.4.3/24 already configured on Ethernet8\nelse\n  config interface ip add Ethernet8 172.16.4.3/24\nfi\nconfig interface ipv6 enable use-link-local-only Ethernet8\nif show ipv6 interface|grep Ethernet8|grep 2001:db8:2:4::3/64; then\n  echo 2001:db8:2:4::3/64 already configured on Ethernet8\nelse\n  config interface ip add Ethernet8 2001:db8:2:4::3/64\nfi\nip link set Ethernet8 mtu 1500\n!\nif show ip interface|grep Ethernet0.1|grep 10.1.0.10/30; then\n  echo 10.1.0.10/30 already configured on Ethernet0.1\nelse\n  config interface ip add Ethernet0.1 10.1.0.10/30\nfi\nif show ipv6 interface|grep Ethernet0.1|grep 2001:db8:3:2::3/64; then\n  echo 2001:db8:3:2::3/64 already configured on Ethernet0.1\nelse\n  config interface ip add Ethernet0.1 2001:db8:3:2::3/64\nfi\n!\nif show ip interface|grep Ethernet0.2|grep 10.1.0.14/30; then\n  echo 10.1.0.14/30 already configured on Ethernet0.2\nelse\n  config interface ip add Ethernet0.2 10.1.0.14/30\nfi\nif show ipv6 interface|grep Ethernet0.2|grep 2001:db8:3:3::3/64; then\n  echo 2001:db8:3:3::3/64 already configured on Ethernet0.2\nelse\n  config interface ip add Ethernet0.2 2001:db8:3:3::3/64\nfi\n!\n#\n# docker-sonic-vs's intfmgrd/orchagent do not program routed-port IPs from CONFIG_DB onto the\n# kernel netdev (loopbacks work; routed ports do not), so BGP/OSPF over links can't come up\n# without this. Bring the data ports admin-up and mirror the CONFIG_DB INTERFACE IPs onto the\n# kernel netdev. Idempotent.\n#\nfor p in $(redis-cli -n 4 keys \"PORT|Ethernet*\" 2>/dev/null | sed 's/PORT|//'); do\n  config interface startup \"$p\" >/dev/null 2>&1 || true\ndone\nredis-cli -n 4 keys \"INTERFACE|Ethernet*|*\" 2>/dev/null | while IFS= read -r k; do\n  ifc=$(echo \"$k\" | cut -d'|' -f2); addr=$(echo \"$k\" | cut -d'|' -f3)\n  [ -n \"$addr\" ] && ip addr add \"$addr\" dev \"$ifc\" 2>/dev/null || true\ndone\n#\n# Enable the FRR daemons needed by the configured modules (docker-sonic-vs ships most of them\n# disabled) and restart FRR once, only if something actually changed.\n#\nif grep -qE '^(ospfd|ospf6d|bgpd)=no' /etc/frr/daemons; then\n  sed -i 's/^ospfd=no/ospfd=yes/' /etc/frr/daemons\n  sed -i 's/^ospf6d=no/ospf6d=yes/' /etc/frr/daemons\n  sed -i 's/^bgpd=no/bgpd=yes/' /etc/frr/daemons\nfi\nsupervisorctl restart frr >/dev/null 2>&1 || service frr restart >/dev/null 2>&1 || true\nsleep 2\n#\n# And now let's configure the interfaces\n#\ncat >/tmp/netlab-initial.frr <<CONFIG\nhostname dut_b\n!\nipv6 forwarding\n!\ninterface Loopback0\n no shutdown\n!\ninterface Ethernet0\n no shutdown\n description dut_b -> r2\n!\ninterface Ethernet4\n no shutdown\n description dut_b -> h2 [stub]\n ipv6 nd ra-interval 5\n no ipv6 nd suppress-ra\n!\ninterface Ethernet8\n no shutdown\n description dut_b -> h4 [stub]\n ipv6 nd ra-interval 5\n no ipv6 nd suppress-ra\n!\ninterface Ethernet0.1\n no shutdown\n description dut_b -> r2\n ipv6 nd ra-interval 5\n no ipv6 nd suppress-ra\n!\ninterface Ethernet0.2\n no shutdown\n description dut_b -> r2\n ipv6 nd ra-interval 5\n no ipv6 nd suppress-ra\n!\ndo write\nCONFIG\nvtysh -f /tmp/netlab-initial.frr\nexit 0\n"
}


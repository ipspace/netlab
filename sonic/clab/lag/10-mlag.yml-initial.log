    "msg": "vlan configuration for dut_s1\n=========================================\n#!/bin/bash\n#\n# SONiC vlan module — switchport membership via the config CLI (access and trunk).\n# VLANs themselves (config_db `Vlan<id>`) are created by initial/sonic-clab.j2 BEFORE the\n# SVIs get addressed; this template adds port membership, THEN syncs it to the kernel itself\n# (see the sync block below) -- docker-sonic-vs's vlanmgrd races at boot and often never\n# mirrors VLAN_MEMBER rows written during the first deploy (a vlanmgrd restart also WIPES\n# bridge state without replaying CONFIG_DB), so relying on it alone silently leaves the L2\n# datapath down (confirmed live: config_db had the VLAN_MEMBER row, but Ethernet0 had no\n# `master Bridge` and cross-node ping failed). Idempotency for the config_db writes is checked\n# against config_db (VLAN_MEMBER rows); the kernel sync below is separately idempotent.\nset -e\nset -x\nif [ \"$(redis-cli -n 4 exists \"VLAN_MEMBER|Vlan1000|PortChannel1\")\" = \"1\" ]; then\n  echo PortChannel1 already a member of Vlan1000\nelse\n  config vlan member add -u 1000 PortChannel1\nfi\nif [ \"$(redis-cli -n 4 exists \"VLAN_MEMBER|Vlan1000|Ethernet8\")\" = \"1\" ]; then\n  echo Ethernet8 already a member of Vlan1000\nelse\n  config vlan member add -u 1000 Ethernet8\nfi\n#\n# Sync CONFIG_DB VLAN/VLAN_MEMBER/VLAN_INTERFACE onto the kernel bridge deterministically --\n# vlanmgrd quirk, see the header comment. Idempotent (all commands are safe to re-run).\n#\nip link show Bridge >/dev/null 2>&1 || { ip link add Bridge type bridge; ip link set Bridge type bridge vlan_filtering 1; }\nip link set Bridge up 2>/dev/null || true\nfor k in $(redis-cli -n 4 keys \"VLAN|Vlan*\" 2>/dev/null); do\n  vid=${k#VLAN|Vlan}\n  bridge vlan add vid \"$vid\" dev Bridge self 2>/dev/null || true\n  ip link show \"Vlan$vid\" >/dev/null 2>&1 || ip link add link Bridge name \"Vlan$vid\" type vlan id \"$vid\"\n  ip link set \"Vlan$vid\" up 2>/dev/null || true\ndone\nredis-cli -n 4 keys \"VLAN_MEMBER|*\" 2>/dev/null | while IFS= read -r k; do\n  v=$(echo \"$k\" | cut -d'|' -f2); port=$(echo \"$k\" | cut -d'|' -f3); vid=${v#Vlan}\n  mode=$(redis-cli -n 4 hget \"$k\" tagging_mode 2>/dev/null)\n  ip link set \"$port\" master Bridge 2>/dev/null || true\n  if [ \"$mode\" = \"tagged\" ]; then\n    bridge vlan add vid \"$vid\" dev \"$port\" 2>/dev/null || true\n  else\n    bridge vlan add vid \"$vid\" dev \"$port\" pvid untagged 2>/dev/null || true\n  fi\ndone\nredis-cli -n 4 keys \"VLAN_INTERFACE|Vlan*|*\" 2>/dev/null | while IFS= read -r k; do\n  svi=$(echo \"$k\" | cut -d'|' -f2); addr=$(echo \"$k\" | cut -d'|' -f3)\n  [ -n \"$addr\" ] && ip addr add \"$addr\" dev \"$svi\" 2>/dev/null || true\ndone\nexit 0\n"
}

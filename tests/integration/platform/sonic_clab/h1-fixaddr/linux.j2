#!/bin/bash
#
# h1-fixaddr custom config — h1 is the M-side of an MLAG-style
# LAG (dual-homed to s1+s2) on a bridge-mode VLAN. netlab's vlan-module address-pool allocation
# doesn't reach the synthesized vlan1000 SVI on a `linux`-device host in this specific
# lag+bridge-mode combo (single-homed h2 on the SAME vlan gets addressed fine, directly on its
# physical port -- the gap is specific to the derived SVI a dual-homed host needs). Netlab-side
# host-addressing quirk, not a SONiC platform limitation -- worked around here so the h1<->h2
# datapath check has a real IP to ping from.
set -e
ip addr add 172.16.0.5/24 dev vlan1000 2>/dev/null || true
exit 0

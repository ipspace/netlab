ok: [dut] => {
    "msg": "initial configuration for dut\n=========================================\n#!/bin/sh\n\nset -e # Exit immediately when any command fails\nset -x # Track commands for troubleshooting\n\nhostname dut\n#\n# Build hosts file\n#\n#\ncat <<'SCRIPT' >/tmp/hosts\n#\n# Created by netlab initial\n#\n172.31.1.9 d1 eth1.d1\n172.31.1.10 d2 eth1.d2\n172.31.1.11 d3 eth1.d3\n172.31.1.12 d4 eth1.d4\n10.0.0.1 dut\n172.31.1.1 vport1.dut\n172.31.1.5 r1 eth1.r1\n172.31.1.6 r2 eth1.r2\n172.31.1.7 r3 eth1.r3\n172.31.1.8 r4 eth1.r4\n10.0.0.2 s2\n172.31.1.2 vlan1.s2\n10.0.0.3 s3\n172.31.1.3 vlan1.s3\n10.0.0.4 s4\n172.31.1.4 vlan1.s4\nSCRIPT\ngrep \"Created by netlab\" /etc/hosts || uniq /tmp/hosts >>/etc/hosts\n\n#\n# Enable forwarding\n#\nsysctl net.inet.ip.forwarding=1\nsysctl net.inet6.ip6.forwarding=1\necho -n > /etc/rad.conf\n\n#\n# Interface configuration\n#\nifconfig lo0 inet 10.0.0.1/32 alias\nifconfig lo0 up\n\n#!/bin/sh\n\nset -e # Exit immediately when any command fails\nset -x # Track commands for troubleshooting\n\nifconfig vlan7001 parent vio1 vnetid 700\nifconfig vlan11 parent vio1 vnetid 1\nifconfig vlan7002 parent vio2 vnetid 700\nifconfig vlan13 parent vio3 vnetid 1\n\n\n\nifconfig vio1 -inet\nifconfig vio1 -inet6\nifconfig vio1 mtu 1500\nifconfig vio1 description \"dut -> s2\"\nifconfig vio1 up\n\nifconfig vio2 -inet\nifconfig vio2 -inet6\nifconfig vio2 mtu 1500\nifconfig vio2 description \"dut -> s3\"\nifconfig vio2 up\n\nifconfig vio3 -inet\nifconfig vio3 -inet6\nifconfig vio3 mtu 1500\nifconfig vio3 description \"dut -> s4\"\nifconfig vio3 up\n\nifconfig vio4 -inet\nifconfig vio4 -inet6\nifconfig vio4 mtu 1500\nifconfig vio4 description \"[Access VLAN red] dut -> r1\"\nifconfig vio4 up\n\nifconfig vio5 -inet\nifconfig vio5 -inet6\nifconfig vio5 mtu 1500\nifconfig vio5 description \"[Access VLAN vlan_1] dut -> d1\"\nifconfig vio5 up\n\nifconfig vlan7001 -inet\nifconfig vlan7001 -inet6\nifconfig vlan7001 description \"[SubIf VLAN red] dut -> s2\"\nifconfig vlan7001 up\n\nifconfig vlan11 -inet\nifconfig vlan11 -inet6\nifconfig vlan11 description \"[SubIf VLAN vlan_1] dut -> s2\"\nifconfig vlan11 up\n\nifconfig vlan7002 -inet\nifconfig vlan7002 -inet6\nifconfig vlan7002 description \"[SubIf VLAN red] dut -> s3\"\nifconfig vlan7002 up\n\nifconfig vlan13 -inet\nifconfig vlan13 -inet6\nifconfig vlan13 description \"[SubIf VLAN vlan_1] dut -> s4\"\nifconfig vlan13 up\n\nifconfig vport1 -inet\nifconfig vport1 -inet6\nifconfig vport1 inet 172.31.1.1/24 \nifconfig vport1 mtu 1500\nifconfig vport1 description \"VLAN vlan_1 (1) -> [d1,d2,s2,d3,s3...]\"\nifconfig vport1 up\n\nifconfig vport700 -inet\nifconfig vport700 -inet6\nifconfig vport700 description \"VLAN red (700) -> [r1,r2,s2,r3,s3...]\"\nifconfig vport700 up\n\n\n#\n# (re-)start RA daemon\n#\npkill -q rad || true\nrad\n"
}
ok: [s2] => {
    "msg": "initial configuration for s2\n=========================================\n#!/bin/bash\n#\nset -e\nset -x\n#\n# Create bash profile script\n#\ncat <<'SCRIPT' >/root/.bash_profile\n#!/bin/bash\n#\nexport PS1=\"\\h(bash)# \"\necho\necho \"Use vtysh to connect to FRR daemon\"\necho\nSCRIPT\n#\n# This is an artifact of unknown provenance that should be removed in a year or two (= 2026/2027)\n#\n# FRR controls these parameters with 'ip forwarding' and 'ipv6 forwarding' commands\n#\nsysctl -w net.ipv4.ip_forward=1\nsysctl -w net.ipv6.conf.all.forwarding=0\n#\ncat <<SCRIPT >.bash_profile\n#!/bin/bash\n#\nexport PS1=\"\\h(bash)$ \"\nexport PATH=$PATH:/usr/sbin\necho \necho \"Use sudo vtysh to connect to FRR daemon\"\necho\nSCRIPT\n#\n# Build hosts file\n#\n#\ncat <<'SCRIPT' >/tmp/hosts\n#\n# Created by netlab initial\n#\n172.31.1.9 d1 eth1.d1\n172.31.1.10 d2 eth1.d2\n172.31.1.11 d3 eth1.d3\n172.31.1.12 d4 eth1.d4\n10.0.0.1 dut\n172.31.1.1 vport1.dut\n172.31.1.5 r1 eth1.r1\n172.31.1.6 r2 eth1.r2\n172.31.1.7 r3 eth1.r3\n172.31.1.8 r4 eth1.r4\n10.0.0.2 s2\n172.31.1.2 vlan1.s2\n10.0.0.3 s3\n172.31.1.3 vlan1.s3\n10.0.0.4 s4\n172.31.1.4 vlan1.s4\nSCRIPT\ngrep \"Created by netlab\" /etc/hosts || uniq /tmp/hosts >>/etc/hosts\n#\n# Configure system defaults on Ubuntu\n#\nhostnamectl set-hostname s2\nPKG_INSTALL=\n#\nif which gpg; then\n  echo \"Package gnupg already installed\"\nelse\n  PKG_INSTALL=\"$PKG_INSTALL gnupg\"\nfi\n#\nif which curl; then\n  echo \"Package curl already installed\"\nelse\n  PKG_INSTALL=\"$PKG_INSTALL curl\"\nfi\n#\nif which bridge; then\n  echo \"Package iproute2 already installed\"\nelse\n  PKG_INSTALL=\"$PKG_INSTALL iproute2\"\nfi\n#\n# PKG_INSTALL always starts with a blank, so we can't just check if it's empty\n# The following hack turns a string that contains only whitespaces into\n# an empty string and removes leading whitespaces\n#\nPKG_INSTALL=`echo $PKG_INSTALL`\nif [ -n \"$PKG_INSTALL\" ]; then\n  echo \"Installing packages $PKG_INSTALL\"\n  if command -v apk >/dev/null; then\n    apk add --no-cache $PKG_INSTALL\n  elif command -v apt-get >/dev/null; then\n    apt-get update -qq && apt-get install -qq $PKG_INSTALL\n  else\n    echo \"Cannot install packages (no supported package manager found)\" >&2\n    exit 1\n  fi\nfi\n#\n# Install FRR on a Ubuntu VM if needed\n#\nif which /usr/lib/frr/frrinit.sh; then\n  echo \"FRR already installed, skipping installation\"\nelse\n  curl -s https://deb.frrouting.org/frr/keys.asc >/etc/apt/trusted.gpg.d/frr.asc\n  FRRVER=\"frr-stable\"\n  echo deb https://deb.frrouting.org/frr $(lsb_release -s -c) $FRRVER > /etc/apt/sources.list.d/frr.list\n  apt-get update -qq && apt-get install -qq frr frr-pythontools bridge-utils ethtool\nfi\n#\n# Enable FRR modules (if not using containerlab bind-mounted /etc/frr/daemons)\n#\n#\n# Enable FRR daemons\n#\n\n/usr/lib/frr/frrinit.sh restart\n\n# Set system defaults\n#\n# Send ARP requests from a sane source IP address\n#\nsysctl -w net.ipv4.conf.all.arp_announce=2\n\n#\n# Create loopbacks, stub and lag/bond devices\n#\nif [ ! -e /sys/class/net/lo ]; then\n  if [ ! -e /sys/devices/virtual/net/lo ]; then\n    ip link add lo type dummy\n    ip link set dev lo up\n  fi\nfi\n\n# Set Linux interface sysctl parameters: Disable IPv6 (for IPv4-only interfaces)\n# or SLAAC (if the device is a router)\n#\nip link set eth1 down\n# Linux interface parameters for eth1\n#\nsysctl -qw net/ipv6/conf/eth1/disable_ipv6=1\nip link set dev eth1 mtu 1500\nip link set eth1 up\n\nip link set eth2 down\n# Linux interface parameters for eth2\n#\nsysctl -qw net/ipv6/conf/eth2/disable_ipv6=1\nip link set dev eth2 mtu 1500\nip link set eth2 up\n\nip link set eth3 down\n# Linux interface parameters for eth3\n#\nsysctl -qw net/ipv6/conf/eth3/disable_ipv6=1\nip link set dev eth3 mtu 1500\nip link set eth3 up\n\n\n#\n# Add vtysh.conf file\necho \"service integrated-vtysh-config\" >/etc/frr/vtysh.conf\n\n#\n# Ensure FRR's log directory exists before enabling file logging\n#\nmkdir -p /var/log/frr && chown frr:frr /var/log/frr\n#\n# Rest of initial configuration done through VTYSH\n#\ncat >/tmp/config <<CONFIG\nhostname s2\n!\nlog file /var/log/frr/frr.log informational\n\n!\nip forwarding\nfrr defaults datacenter\n!\ninterface lo\n no shutdown\n ip address 10.0.0.2/32\n!\ninterface eth1\n no shutdown\n description s2 -> dut\n ! no ip address\n!\ninterface eth2\n no shutdown\n description [Access VLAN red] s2 -> r2\n ! no ip address\n!\ninterface eth3\n no shutdown\n description [Access VLAN vlan_1] s2 -> d2\n ! no ip address\n!\ninterface eth1.700\n no shutdown\n description [SubIf VLAN red] s2 -> dut\n ! no ip address\n!\ninterface eth1.1\n no shutdown\n description [SubIf VLAN vlan_1] s2 -> dut\n ! no ip address\n!\ninterface vlan700\n no shutdown\n description VLAN red (700) -> [r1,dut,r2,r3,s3...]\n ! no ip address\n!\ninterface vlan1\n no shutdown\n description VLAN vlan_1 (1) -> [d1,dut,d2,d3,s3...]\n ip address 172.31.1.2/24\n!\ndo write\nCONFIG\nvtysh -f /tmp/config\n\n!\nexit 0\n"
}

#!/bin/bash
#
set -e
#
if ! command -v wg >/dev/null; then
  echo "wireguard-tools package is not installed (should be installed during initial configuration)" >&2
  exit 1
fi
#
{% for intf in netlab_interfaces if intf.tunnel.mode|default('') in ['wireguard'] %}
if [ ! -e /sys/class/net/{{ intf.ifname }} ]; then
  if [ ! -e /sys/devices/virtual/net/{{ intf.ifname }} ]; then
    ip link add {{ intf.ifname }} type wireguard
  fi
fi
{{ linux_intf_sysctl(intf,role) }}
{% endfor %}
#
setup_wg_vrf_underlay() {
  local vrf_table="$1"
  local rule_pref="$2"
  local tunnel_af="$3"

  # The global WireGuard listening socket must accept encrypted packets that
  # arrive on a VRF (l3mdev) underlay interface. This is gated by the kernel's
  # udp_l3mdev_accept toggle, which is exposed only as net.ipv4.udp_l3mdev_accept
  # even though it applies to IPv6 too: the UDP l3mdev socket-match helper reads
  # net->ipv4.sysctl_udp_l3mdev_accept regardless of the socket's address family,
  # and there is deliberately no net.ipv6 counterpart. So we set it for both the
  # IPv4 and IPv6 tunnel underlays.
  sysctl -qw net.ipv4.udp_l3mdev_accept=1

  local ip_af=""
  [ "${tunnel_af}" = "ipv6" ] && ip_af="-6"

  if ! ip ${ip_af} rule show pref "${rule_pref}" 2>/dev/null | grep -q "fwmark ${rule_pref}.*lookup ${vrf_table}"; then
    ip ${ip_af} rule add pref "${rule_pref}" fwmark "${rule_pref}" lookup "${vrf_table}"
  fi
}
#
create_wg() {
  local ifname="$1"
  local private_key="$2"
  local listen_port="$3"
  local peer_key="$4"
  local peer_endpoint="$5"
  local peer_allowed="$6"
  local keepalive="$7"
  local mtu="$8"
  local tunnel_af="${9:-ipv4}"
  local vrf_table="${10:-}"
  local rule_pref="${11:-}"
  local wg_fwmark=""

  if [ -n "${vrf_table}" ] && [ -n "${rule_pref}" ]; then
    setup_wg_vrf_underlay "${vrf_table}" "${rule_pref}" "${tunnel_af}"
    wg_fwmark="fwmark ${rule_pref}"
  fi

  wg set "${ifname}" \
    private-key <(printf '%s\n' "${private_key}") \
    listen-port "${listen_port}" \
    ${wg_fwmark} \
    peer "${peer_key}" \
    allowed-ips "${peer_allowed}" \
    endpoint "${peer_endpoint}" \
    persistent-keepalive "${keepalive}"

  ip link set dev "${ifname}" mtu "${mtu}" up
}
#
{% for intf in netlab_interfaces if intf.tunnel.mode|default('') in ['wireguard'] %}
{%   set af = intf.tunnel.af %}
{%   set dst = intf.tunnel._destination %}
{%   set peer_endpoint = ('[' ~ dst[af] ~ ']:' ~ dst.listen_port) if af == 'ipv6' else (dst[af] ~ ':' ~ dst.listen_port) %}
{%   set vrf_name = intf.tunnel.vrf|default('') %}
{%   set vrf_table = vrfs[vrf_name].vrfidx if vrf_name and vrf_name in vrfs else '' %}
{%   set rule_pref = 10000 + intf.ifindex if vrf_name and vrf_table else '' %}
create_wg \
  {{ intf.ifname }} \
  {{ intf.tunnel.private_key }} \
  {{ intf.tunnel.listen_port }} \
  {{ dst.public_key }} \
  {{ peer_endpoint }} \
  {{ intf.tunnel.allowed_ips }} \
  {{ intf.tunnel.persistent_keepalive }} \
  {{ intf.mtu }} \
  {{ intf.tunnel.af }}{% if vrf_name and vrf_table %} \
  {{ vrf_table }} \
  {{ rule_pref }}{% endif %}

{% endfor %}
exit 0

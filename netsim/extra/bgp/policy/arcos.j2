{#
  ArcOS bgp.policy plugin configuration -- apply the routing policies the plugin generated to the
  BGP neighbors. The policies themselves (locpref/MED/community/prefix matching) are rendered by
  templates/routing/arcos.j2, which emits one policy-definition per address family named
  <policy>-ipv4 / <policy>-ipv6; the per-neighbor apply-policy below is per address family too, so
  it picks the matching one.

  The export-policy leaf-list is rendered by the shared templates/bgp/arcos.macro.j2 export_policy
  macro rather than here, because a session can carry BOTH a bgp.policy export policy and the
  next-hop-self policy from the bgp module. This template is deployed AFTER templates/bgp/arcos.j2
  and confd replaces a leaf-list wholesale, so both writers have to emit the same complete chain.

  A dual-stack peer is TWO ArcOS neighbors (one keyed on the IPv4 transport address, one on the
  IPv6 one -- see templates/bgp/arcos.j2), each carrying a single address family, so the neighbor
  address and the AFI/SAFI always come from the same `af`.

  Applied in the default network-instance AND in every L3VRF that has policy-carrying neighbors:
  templates/vrf/arcos.j2 renders a per-VRF BGP instance tagged with the VRF name, and this template
  is deployed after it, so the instance a VRF neighbor lives in already exists.

  Not rendered because ArcOS cannot express them, and therefore not declared in
  netsim/devices/arcos.yml either: bgp.weight (no per-neighbor weight leaf), bgp.bandwidth,
  bgp.role (RFC 9234), AS-path prepending, and large/extended-community set actions.
#}
{#- The bgp.policy plugin templates are searched from netsim/extra and netsim/ansible/templates,
    not from netsim/ansible, so the shared BGP macros are imported WITHOUT the templates/ prefix
    that templates/bgp/arcos.j2 and templates/vrf/arcos.j2 use. -#}
{% import "bgp/arcos.macro.j2" as bgpcfg %}
{% macro apply_policy(nb_list) %}
{%   for af in ['ipv4','ipv6'] %}
{%     for n in nb_list if n[af] is defined and n[af] is string %}
{%       if n.policy['in'] is defined %}
 neighbor {{ n[af] }} afi-safi {{ af|upper }}_UNICAST apply-policy import-policy [ {{ n.policy['in'] }}-{{ af }} ]
{%       endif %}
{{ bgpcfg.export_policy(n,af) -}}
{%     endfor %}
{%   endfor %}
{%- endmacro %}
{% set _pol_ngb = bgp.neighbors|default([])|selectattr('policy','defined')|list %}
{% if _pol_ngb %}
network-instance default protocol BGP b1
{{ apply_policy(_pol_ngb) -}}
{% endif %}
{% for vname,vdata in (vrfs|default({})).items() %}
{%   set _vrf_pol_ngb = vdata.bgp.neighbors|default([])|selectattr('policy','defined')|list %}
{%   if _vrf_pol_ngb %}
network-instance {{ vname }} protocol BGP {{ vname }}
{{ apply_policy(_vrf_pol_ngb) -}}
{%   endif %}
{% endfor %}

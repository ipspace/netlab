{#
  The update-source is configured in the BGP configuration template (neighbor._source_intf)
#}
router bgp {{ bgp.as }}
{% for n in bgp.neighbors if n.multihop is defined %}
{%   for af in ['ipv4','ipv6'] if n[af] is defined %}
 neighbor {{ n[af] }} ebgp-multihop {{ n.multihop }}
{%   endfor %}
{% endfor %}
!

# syntax=docker/dockerfile:1
# --- Stage 1: Build Stage ---
FROM debian:bookworm-slim AS builder

# Install compilation dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    build-essential \
    flex \
    bison \
    libncurses-dev \
    libreadline-dev \
    libssh-dev \
    autoconf \
    wget \
    && rm -rf /var/lib/apt/lists/*

{% set _clab = defaults.daemons.bird.clab %}
{% set _sw_version = sw_version if sw_version is defined else _clab.sw_version %}
{% if not _sw_version %}{{ fail('sw_version must be defined in defaults.daemons.bird.clab') }}{% endif %}
{% set _url = _clab.sw_download_url %}
{% if not _url %}{{ fail('sw_download_url must be defined in defaults.daemons.bird.clab') }}{% endif %}
{% set _sw_download_url = _url.replace('{sw_version}', _sw_version) %}

# Download and extract source code
RUN set -e; \
    if ! wget -q -O /tmp/sw-src.tar.gz "{{ _sw_download_url }}"; then \
      echo "ERROR: Cannot download BIRD {{ _sw_version }} from {{ _sw_download_url }} — version may not exist"; \
      exit 1; \
    fi; \
    tar -xzf /tmp/sw-src.tar.gz

WORKDIR /bird-{{ _sw_version }}

# Configure, compile, and install
RUN ./configure --prefix=/usr --sysconfdir=/etc/bird --localstatedir=/var \
    && make -j$(nproc) \
    && make install

# --- Stage 2: Runtime Stage ---
FROM debian:bookworm-slim

LABEL maintainer="Netlab project <netlab.tools>"
LABEL description="BIRD Internet Routing Daemon v2 built from source ({{ _sw_version }})"

# Install runtime dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    iproute2 \
    iputils-ping \
    net-tools \
    procps \
    libreadline8 \
    libssh-4 \
    && rm -rf /var/lib/apt/lists/*

# Copy binaries and built directories from the builder stage
COPY --from=builder /usr/sbin/bird /usr/sbin/bird
COPY --from=builder /usr/sbin/birdcl /usr/sbin/birdcl
COPY --from=builder /etc/bird /etc/bird

# Wait for netlab initial to execute bound /etc/config scripts, then start BIRD.
# EVPN/VXLAN kernel interfaces must exist before BIRD starts (see bird/vlan.j2).
RUN cat >/entrypoint.sh <<'ENTRYPOINT'
#!/bin/bash
set -e

log() {
  echo "bird: $*" >&2
}

wait_for_netlab_config() {
  local timeout="${NETLAB_CONFIG_WAIT:-120}"
  local waited=0
  local marker="${NETLAB_CONFIG_DONE:-/var/run/netlab-config-done}"

  if ! compgen -G '/etc/config/[0-9]*-*.sh' > /dev/null; then
    log "no netlab configuration scripts found, starting BIRD"
    return 0
  fi

  log "waiting for netlab initial (${marker}, timeout ${timeout}s)"

  while [ "$waited" -lt "$timeout" ]; do
    if [ -f "$marker" ]; then
      log "netlab configuration complete"
      return 0
    fi
    if [ "$((waited % 10))" -eq 0 ]; then
      log "still waiting for netlab initial (${waited}s elapsed)"
    fi
    sleep 1
    waited=$((waited + 1))
  done

  log "timeout waiting for netlab initial (${marker})"
  return 1
}

wait_for_evpn_kernel() {
  if [ ! -f /etc/bird/evpn.mod.conf ]; then
    return 0
  fi

  local timeout="${NETLAB_EVPN_WAIT:-30}"
  local waited=0

  log "waiting for EVPN kernel interfaces (timeout ${timeout}s)"

  while [ "$waited" -lt "$timeout" ]; do
    local ready=1

    if ! compgen -G '/sys/class/net/vxlan*' > /dev/null; then
      ready=0
    else
      for vx in /sys/class/net/vxlan*; do
        local name="${vx##*/}"
        if ! ip link show dev "$name" 2>/dev/null | grep -q 'master '; then
          ready=0
          break
        fi
      done
    fi

    if compgen -G '/sys/class/net/vlan*' > /dev/null; then
      for br in /sys/class/net/vlan*; do
        local name="${br##*/}"
        local state
        state="$(cat "/sys/class/net/$name/operstate" 2>/dev/null || echo down)"
        if [ "$state" = "down" ]; then
          ready=0
          break
        fi
      done
    else
      ready=0
    fi

    if [ "$ready" -eq 1 ]; then
      log "EVPN kernel interfaces ready"
      return 0
    fi

    sleep 1
    waited=$((waited + 1))
  done

  log "warning: timeout waiting for EVPN kernel interfaces"
  return 0
}

wait_for_netlab_config
wait_for_evpn_kernel

log "network interfaces:"
ip -br link >&2 || true

if [ -f /etc/bird/bird.conf ]; then
  log "checking BIRD configuration"
  if bird -p -c /etc/bird/bird.conf >&2; then
    log "BIRD configuration is valid"
  else
    log "BIRD configuration check failed"
    exit 1
  fi
else
  log "warning: /etc/bird/bird.conf not found"
fi

log "starting BIRD (foreground, debug on stderr)"
exec bird -f -c /etc/bird/bird.conf -d
ENTRYPOINT
RUN chmod +x /entrypoint.sh

# Create runtime directory for control sockets
RUN mkdir -p /var/run /etc/config

ENTRYPOINT ["/entrypoint.sh"]

# syntax=docker/dockerfile:1
# --- Stage 1: Build Stage ---
FROM debian:bookworm-slim AS builder

# Install compilation dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    build-essential \
    flex \
    bison \
    libncurses-dev \
    libreadline-dev \
    libssh-dev \
    autoconf \
    wget \
    && rm -rf /var/lib/apt/lists/*

{% set _clab = defaults.daemons.bird.clab %}
{% set _sw_version = sw_version if sw_version is defined else _clab.sw_version %}
{% if not _sw_version %}{{ fail('sw_version must be defined in defaults.daemons.bird.clab') }}{% endif %}
{% set _url = _clab.sw_download_url %}
{% if not _url %}{{ fail('sw_download_url must be defined in defaults.daemons.bird.clab') }}{% endif %}
{% set _sw_download_url = _url.replace('{sw_version}', _sw_version) %}

# Download and extract source code
RUN set -e; \
    if ! wget -q -O /tmp/sw-src.tar.gz "{{ _sw_download_url }}"; then \
      echo "ERROR: Cannot download BIRD {{ _sw_version }} from {{ _sw_download_url }} — version may not exist"; \
      exit 1; \
    fi; \
    tar -xzf /tmp/sw-src.tar.gz

WORKDIR /bird-{{ _sw_version }}

# Configure, compile, and install
RUN ./configure --prefix=/usr --sysconfdir=/etc/bird --localstatedir=/var \
    && make -j$(nproc) \
    && make install

# --- Stage 2: Runtime Stage ---
FROM debian:bookworm-slim

LABEL maintainer="Netlab project <netlab.tools>"
LABEL description="BIRD Internet Routing Daemon v2 built from source ({{ _sw_version }})"

# Install runtime dependencies
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    iproute2 \
    iputils-ping \
    net-tools \
    procps \
    libreadline8 \
    libssh-4 \
    && rm -rf /var/lib/apt/lists/*

# Copy binaries and built directories from the builder stage
COPY --from=builder /usr/sbin/bird /usr/sbin/bird
COPY --from=builder /usr/sbin/birdcl /usr/sbin/birdcl
COPY --from=builder /etc/bird /etc/bird

# Run netlab interface setup scripts before starting BIRD.
# EVPN/VXLAN configs reference kernel tunnel devices that must exist first;
# starting BIRD too early triggers a known segfault (BIRD issue #423).
RUN cat >/entrypoint.sh <<'ENTRYPOINT'
#!/bin/bash
set -e

wait_for_interfaces() {
  local timeout="${NETLAB_INTERFACE_WAIT:-30}"
  local waited=0

  while [ "$waited" -lt "$timeout" ]; do
    if [ -d /sys/class/net/eth1 ]; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done

  echo "Timeout waiting for containerlab interfaces (eth1)" >&2
  return 1
}

if [ -d /etc/config ] && compgen -G '/etc/config/[0-9]*-*.sh' > /dev/null; then
  wait_for_interfaces
  for script in /etc/config/[0-9]*-*.sh; do
    [ -f "$script" ] || continue
    bash "$script"
  done
fi

exec bird -f -c /etc/bird/bird.conf -d
ENTRYPOINT
RUN chmod +x /entrypoint.sh

# Create runtime directory for control sockets
RUN mkdir -p /var/run /etc/config

# Expose BGP (179) and OSPF (89) routing ports
EXPOSE 179

ENTRYPOINT ["/entrypoint.sh"]

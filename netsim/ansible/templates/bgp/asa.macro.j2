{#
   BGP neighbor definition: remote-as, description, update-source
#}
{% macro neighbor_global(n,ip) %}
    neighbor {{ ip }} remote-as {{ n.as }}
    neighbor {{ ip }} description {{ n.name }}
{% if n._source_intf is defined %}
    neighbor {{ ip }} update-source {{ n._source_intf.ifname }}
{% endif %}
{%- endmacro -%}
{#
   Address family BGP neighbor definition
#}
{% macro neighbor_af(n,ip,bgp) %}
    neighbor {{ ip }} activate
{% if n.type == 'ibgp' and bgp.next_hop_self|default(False) %}
    neighbor {{ ip }} next-hop-self
{% endif %}
{% if bgp.community[n.type]|default([]) %}
    neighbor {{ ip }} send-community
{% endif %}
{%- endmacro -%}
{#
   BGP network statement
#}
{% macro bgp_network(af,pfx) %}
{%   if af == 'ipv4' %}
    network {{ pfx|ansible.utils.ipaddr('network') }} mask {{ pfx|ansible.utils.ipaddr('netmask') }}
{%   else %}
    network {{ pfx|ansible.utils.ipaddr('0') }}
{%   endif %}
{%- endmacro %}

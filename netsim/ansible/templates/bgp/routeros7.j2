{% import "routeros7.macro.j2" as bgpcfg %}

/routing/bgp/template add name=main as={{ bgp.as }} output.network=bgp-networks
/routing/bgp/instance add name=main as={{ bgp.as }}

{% if bgp.router_id is defined %}
/routing/bgp/instance set [/routing/bgp/instance find name=main] router-id={{ bgp.router_id }}
{% endif %}

{%- if bgp.rr|default(False) and bgp.rr_cluster_id|default(False) %}
/routing/bgp/instance set [/routing/bgp/instance find name=main] cluster-id={{ bgp.rr_cluster_id }}
{% endif %}


{#
  Add route-map for next-hop-self
#}
{% for n in bgp.neighbors %}
{%   for af in ['ipv4','ipv6'] if n[af] is defined %}
{%     if n.type == 'ebgp' %}
/routing/filter/rule add chain=filter_rr_self_ebgp rule="if ( bgp-input-remote-addr == {{n[af]}} ) { set gw {{bgp.router_id}};}"
{%     endif %}
{%   endfor %}
{% endfor %}
/routing/filter/rule add chain=filter_rr_self_ebgp rule="return;"

{#
  Add route-maps for excluding different community types
#}
/routing/filter/rule/add chain=rm_extended_communities rule="delete bgp-ext-communities rt; delete bgp-ext-communities soo; delete bgp-ext-communities other;"
/routing/filter/rule/add chain=rm_extended_communities rule="return;"
/routing/filter/rule/add chain=rm_large_communities rule="delete bgp-lrg-communities all;"
/routing/filter/rule/add chain=rm_large_communities rule="return;"
/routing/filter/rule/add chain=rm_standard_communities rule="delete bgp-std-communities other; delete bgp-ext-communities wk;"
/routing/filter/rule/add chain=rm_standard_communities rule="jump rm_large_communities;"
/routing/filter/rule/add chain=rm_standard_communities rule="return;"


{% for n in bgp.neighbors %}
{%   for af in ['ipv4','ipv6'] if n[af] is defined %}
{{     bgpcfg.neighbor(n,n[af],bgp,'main') }}
{{     bgpcfg.neighbor_community(n,n[af],bgp) }}
{%   endfor %}
{% endfor %}


{# Set networks to announce #}
{% for af in ['ipv4','ipv6'] %}
{%   if bgp[af] is defined %}
{%     for l in netlab_interfaces if l.bgp.advertise|default("") and l[af] is defined and not 'vrf' in l %}
{{       bgpcfg.bgp_network(af,l[af]) }}
{%     endfor %}

{%     for pfx in bgp.originate|default([]) if af == 'ipv4' %}
{{       bgpcfg.bgp_network(af,pfx) }}
{%     endfor %}

{%   endif %}
{% endfor %}

{#
  Add extra IPv4 prefixes
#}
{% for pfx in bgp.originate|default([]) %}
/ip route add blackhole dst-address={{ pfx|ansible.utils.ipaddr('0') }}
{% endfor %}

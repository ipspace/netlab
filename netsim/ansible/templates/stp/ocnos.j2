{#
  The STP protocol is set when the VLAN-aware bridge is created in the initial configuration.
  STP is disabled on individual bridge ports (all of them when STP is disabled on the node)
#}
{% if stp.priority is defined %}
bridge 1 priority {{ stp.priority }}
!
{% endif %}
{% for l in interfaces if l.vlan.trunk_id is defined or l.vlan.access_id is defined %}
{%   if not stp.enable|default(True) or not l.stp.enable|default(True) %}
interface {{ l.ifname }}
 spanning-tree disable
!
{%   endif %}
{% endfor %}

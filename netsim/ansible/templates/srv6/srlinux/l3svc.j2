{% import 'templates/bgp/srlinux.macro.j2' as bgpcfg with context %}
{% for af in srv6.bgp if srv6.bgp[af] %}
{%   if loop.first %}
#
# SRv6 layer-3 services
#
# Create DTx uSIDs in the default network instance to support layer-3 services
#
- path: /network-instance[name=default]/segment-routing/srv6/instance[id=1]
  value:
    locator:
    - locator-name: {{ inventory_hostname }}
      micro-segment:
        function:
{%   endif %}
          udt{{ af.replace('ipv','') }}:
            value: {{ '1' if af == 'ipv4' else '2' }}
{% endfor %}
{% if 'ipv4' in srv6.bgp %}
- path: /network-instance[name=default]/ip-forwarding
  value:
    receive-ipv4-check: false
{% endif %}
{% for af in srv6.bgp if srv6.bgp[af] %}
{%   if loop.first %}
#
# Enable SRv6 TLVs for global layer-3 services
#
- path: /network-instance[name=default]/protocols/bgp
  value:
    srv6:
      source-address: {{ loopback.ipv6|ansible.utils.ipaddr('address') }}
    afi-safi:
{%   endif %}
    - afi-safi-name: {{ af }}-unicast
      {{ af }}-unicast:
        srv6:
          process-received-srv6-tlvs: true
          add-srv6-tlvs:
            locator-name: {{ inventory_hostname }}
{% endfor %}
{% for n in bgp.neighbors|default([]) if 'ipv4' in n.srv6.bgp|default({}) %}
{%   if loop.first %}
#
# Enable RFC 8950 IPv4 AF on SRv6-enabled IPv6 BGP sessions
#
- path: /network-instance[name=default]/protocols/bgp
  value:
    neighbor:
{%   endif %}
    - peer-address: "{{ n.ipv6 }}"
      afi-safi:
      - afi-safi-name: ipv4-unicast
        admin-state: enable
        ipv4-unicast:
          advertise-ipv6-next-hops: True
          receive-ipv6-next-hops: True
{% endfor %}
{% for af in ['ipv4','ipv6'] if af in srv6.bgp %}
{%   for n in bgp.neighbors|default([]) if n.srv6 is not defined and n[af]|default(False) is string %}
{%     if loop.first %}
#
# Remove SRv6 TLVs from all other {{ af }} neighbors
#
{%     endif %}
- path: /network-instance[name=default]/protocols/bgp
  value:
    neighbor:
    - peer-address: "{{ n[af] }}"
      afi-safi:
      - afi-safi-name: {{ af }}-unicast
        {{ af }}-unicast:
          srv6:
            strip-srv6-tlvs: true
{%     if af == 'ipv6' and n.ipv4_rfc8950 %}
      - afi-safi-name: ipv4-unicast
        ipv4-unicast:
          srv6:
            strip-srv6-tlvs: true
{%     endif %}
{%   endfor %}
{% endfor %}
{% for n in bgp.neighbors|default([]) if n.srv6 is not defined and n.local_if is defined %}
{%   if loop.first %}
#
# Remove SRv6 TLVs from interface EBGP neighbors
#
{%   endif -%}
{{ bgpcfg.cfg_interface_peer_group('default',n) }}
    afi-safi:
    - afi-safi-name: ipv4-unicast
      ipv4-unicast:
        srv6:
          strip-srv6-tlvs: true
    - afi-safi-name: ipv6-unicast
      ipv6-unicast:
        srv6:
          strip-srv6-tlvs: true
{% endfor %}

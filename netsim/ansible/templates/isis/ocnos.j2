{#
  OcNOS uses "level-2-only" where netlab uses "level-2". netlab IS-IS uses wide metrics, and
  OcNOS sets them with "isis wide-metric" ("isis metric" takes narrow metrics only, 1-63).
#}
{% set lvl = { 'level-1': 'level-1', 'level-2': 'level-2-only', 'level-1-2': 'level-1-2' } %}
{% set mt_lvl = { 'level-1': 'level-1', 'level-2': 'level-2', 'level-1-2': 'level-1-2' } %}
!
router isis {{ isis.instance }}
 is-type {{ lvl[isis.type]|default(isis.type) }}
 net {{ isis.net }}
 metric-style wide
 dynamic-hostname
{% for l in netlab_interfaces if l.isis.passive|default(False) and 'vrf' not in l %}
 passive-interface {{ l.ifname }}
{% endfor %}
{% if isis.af.ipv6 is defined %}
 address-family ipv6 unicast
  multi-topology {{ mt_lvl[isis.type]|default('level-1-2') }}
 exit-address-family
{% endif %}
!
{% for l in netlab_interfaces if 'isis' in l and 'vrf' not in l %}
interface {{ l.ifname }}
{%   if 'ipv4' in l and isis.af.ipv4 is defined %}
 ip router isis {{ isis.instance }}
{%   endif %}
{%   if 'ipv6' in l and isis.af.ipv6 is defined %}
 ipv6 router isis {{ isis.instance }}
{%   endif %}
{%   if l.isis.network_type is defined %}
 isis network {{ l.isis.network_type }}
{%   endif %}
{%   if l.isis.type is defined %}
 isis circuit-type {{ lvl[l.isis.type]|default(l.isis.type) }}
{%   endif %}
{%   if l.isis.metric is defined %}
 isis wide-metric {{ l.isis.metric }}
{%   endif %}
!
{% endfor %}

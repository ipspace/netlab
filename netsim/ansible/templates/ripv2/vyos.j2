{% if ripv2.af.ipv4|default(False) %}

set protocols rip version 2
{%   if ripv2.timers is defined %}
set protocols rip timers update {{ ripv2.timers['update'] }}
set protocols rip timers timeout {{ ripv2.timers.timeout }}
set protocols rip timers garbage-collection {{ ripv2.timers.garbage }}
{%   endif %}

{%   for intf in netlab_interfaces if intf.ipv4|default(False) is string and 'vrf' not in intf %}
set protocols rip network {{ intf.ipv4|ansible.utils.ipaddr(0) }}
{%     if intf.ripv2.passive|default(False) or not 'ripv2' in intf %}
set protocols rip passive-interface {{ intf.ifname }}
{%     endif %}
{%   endfor %}

{% endif %}

{% if ripv2.af.ipv6|default(False) %}
{%   if ripv2.timers is defined %}

set protocols ripng timers update {{ ripv2.timers['update'] }}
set protocols ripng timers timeout {{ ripv2.timers.timeout }}
set protocols ripng timers garbage-collection {{ ripv2.timers.garbage }}
{%   endif %}
{%   for intf in netlab_interfaces if 'ipv6' in intf and not 'vrf' in intf %}

set protocols ripng network {{ intf.ipv6|ansible.utils.ipaddr(0) }}
{%     if intf.ripv2.passive|default(False) or not 'ripv2' in intf %}
set protocols ripng passive-interface {{ intf.ifname }}
{%     endif %}

{%   endfor %}
{% endif %}

{#
  OcNOS uses IOS-like prefix lists, AS-path lists, community lists, and route maps.
  The filters are configured before the route maps that reference them.
#}
{% import '_route_map_ios.j2' as routemap with context %}
{% if routing.prefix|default({}) %}
{%   include '_prefix_list_ios.j2' %}
{% endif %}
{% for asp_name,asp_list in routing.aspath|default({})|dictsort %}
!
{%   for asp_line in asp_list %}
ip as-path access-list {{ asp_name }} {{ asp_line.action }} {{ asp_line.path }}
{%   endfor %}
{% endfor %}
{% for c_name,c_value in routing.community|default({})|dictsort %}
!
{%   for c_line in c_value.value %}
ip community-list {{ c_value.cl_type }} {{ c_name }} {{ c_line.action }} {{ c_line._value }}
{%   endfor %}
{% endfor %}
{% if routing.policy|default({}) %}
{%   call(p_entry,af_list) routemap.create_route_maps(routing.policy) -%}
{{     routemap.common_route_map_entry(p_entry,af_list) }}
{%-  endcall %}
{% endif %}
!
{#
  OcNOS static routes use slash prefixes; "null" is the discard next hop. A next hop
  that is not on a connected subnet (no next-hop interface) needs the "recursive"
  keyword, or OcNOS keeps the route inactive
#}
{% for sr_data in routing.static|default([]) %}
{%   set sr_vrf = 'vrf ' ~ sr_data.vrf ~ ' ' if 'vrf' in sr_data else '' %}
{%   for sr_af in ['ipv4','ipv6'] if sr_af in sr_data %}
{%     set sr_nh = 'null' if 'discard' in sr_data.nexthop else sr_data.nexthop[sr_af] %}
{%     set sr_rec = ' recursive' if 'discard' not in sr_data.nexthop and 'intf' not in sr_data.nexthop else '' %}
{{ 'ip' if sr_af == 'ipv4' else 'ipv6' }} route {{ sr_vrf }}{{ sr_data[sr_af] }} {{ sr_nh }}{{ sr_rec }}
{%   endfor %}
{% endfor %}

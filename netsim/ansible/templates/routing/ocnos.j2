{#
  OcNOS static routes use slash prefixes; "null" is the discard next hop
#}
{% for sr_data in routing.static|default([]) if 'vrf' not in sr_data %}
{%   for sr_af in ['ipv4','ipv6'] if sr_af in sr_data %}
{%     set sr_nh = 'null' if 'discard' in sr_data.nexthop else sr_data.nexthop[sr_af] %}
{{ 'ip' if sr_af == 'ipv4' else 'ipv6' }} route {{ sr_data[sr_af] }} {{ sr_nh }}
{%   endfor %}
{% endfor %}

{% macro r_acl_addr(a, af) -%}
{%- if a.any is defined and a.any -%}any
{%- elif a.host is defined and a.host -%}host {{ (a.ipv4 if af == 'ipv4' else a.ipv6) | ipaddr('address') }}
{%- elif af == 'ipv4' and a.ipv4 is defined -%}{{ a.ipv4 | ipaddr('network') }} {{ a.ipv4 | ipaddr('hostmask') }}
{%- elif af == 'ipv6' and a.ipv6 is defined -%}{{ a.ipv6 }}
{%- else -%}any{%- endif -%}
{%- endmacro %}

{% macro r_acl_port(p) -%}
{%- if p.port_range is defined %} range {{ p.port_range.min }} {{ p.port_range.max }}
{%- elif p.port is defined %} {{ p.port_op | default('eq') }} {{ p.port }}
{%- endif -%}
{%- endmacro %}

{% for name, acl in routing.acl.items() %}
!
ip access-list extended {{ name }}_{{ acl.af }}
{% for e in acl.value %}
{% set est = "established" if e.established is defined else "" %}
{% set log = "log" if e.log is defined else "" %}
{% if e.description is defined %}
  {{e.sequence}} remark {{e.description}}
{% else %}
  {{ e.sequence}} {{ e.action}} {{e.protocol}} {{r_acl_addr(e.src, acl.af)}} {{ r_acl_port(e.src)}} {{ r_acl_addr(e.dst, acl.af) }} {{ r_acl_port(e.dst)}} {{est}} {{log}}
{% endif %}
{% endfor %}
{% endfor %}

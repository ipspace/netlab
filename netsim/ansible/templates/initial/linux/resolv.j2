# /etc/resolv.conf generated by netlab
{#
    Use the first three DNS server addresses, preferring IPv6 over IPv4. As a fallback, use
    Docker DNS server.

    Please note that while this file is used unconditionally on containers supporting the DNS
    client, it's only used on the VMs if the IPv4/IPv6 DNS server is defined, so a VM will never
    try to use the Docker nameserver.
#}
{% set dns_srv_list = (services.dns.ipv6|default([]) + services.dns.ipv4|default([]))[:3] or ['127.0.0.11'] %}
{% for srv_ip in dns_srv_list %}
nameserver {{ srv_ip }}
{% endfor %}
{% if services.dns.domain|default(False) %}
search {{ services.dns.domain }}
{% endif %}
options edns0 trust-ad ndots:0

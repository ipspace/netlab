{% for vname,vdata in vrfs.items() %}
ip vrf {{ vname }}
{%   if vdata.rd is defined %}
 rd {{ vdata.rd }}
{%   endif %}
{%   for rt in vdata.import|default([]) %}
 route-target import {{ rt }}
{%   endfor %}
{%   for rt in vdata.export|default([]) %}
 route-target export {{ rt }}
{%   endfor %}
!
{% endfor %}

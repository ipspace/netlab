#
# Enable FRR daemons
#
{% for m in module|default([]) if netlab_frr_daemons[m] is defined %}
{%   for frr_m in netlab_frr_daemons[m] %}
echo "{{ frr_m }}=yes" >>/etc/frr/daemons
{%   endfor %}
{% endfor %}
{% if frr.daemons is sameas true %}
sed -i 's/^\([a-z0-9]*d\)=no/\1=yes/' /etc/frr/daemons
{% elif frr.daemons is defined and frr.daemons %}
{%   for frr_m in frr.daemons %}
echo "{{ frr_m }}=yes" >>/etc/frr/daemons
{%   endfor %}
{% endif %}

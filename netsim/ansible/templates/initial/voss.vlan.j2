{% for vname,vdata in vlans.items() %}
{%   if vname|lower != 'default' and vdata.id != 1 %}
vlan create {{ vdata.id }} name "{{ vname }}" type port-mstprstp 0
{#     Extend the VLAN over the SPB fabric, I-SID derived from the VLAN ID (placeholder until an SPB module exists) #}
vlan i-sid {{ vdata.id }} {{ 10000 + vdata.id }}
{%   endif %}
{% endfor +%}

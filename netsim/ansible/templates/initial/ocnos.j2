hostname {{ inventory_hostname.replace("_","-") }}
!
{% if vrfs is defined %}
{%   include 'ocnos.vrf.j2' +%}
{% endif %}
{% if vlans is defined %}
{%   include 'ocnos.vlan.j2' +%}
{% endif %}
{% for l in netlab_interfaces %}
interface {{ l.ifname }}
{%   if l.name is defined %}
 description {{ l.name|replace('"','') }}{{ " [" + l.role + "]" if l.role is defined else "" }}
{%   elif l.type|default("") == "stub" %}
 description Stub interface
{%   endif %}
{#   OcNOS 7.0.0 rejects a VLAN interface MTU above 1500 #}
{%   if l.mtu is defined and l.type|default("") != "loopback" and (l.type|default("") != "svi" or l.mtu <= 1500) %}
 mtu {{ l.mtu }}
{%   endif %}
{#   VRF membership has to be configured before the IP addresses #}
{%   if l.vrf is defined %}
 ip vrf forwarding {{ l.vrf }}
{%   endif %}
{%   if 'ipv4' in l and l.ipv4 is string %}
{#     "lo" already has 127.0.0.1/8 as its primary address #}
 ip address {{ l.ipv4 }}{{ " secondary" if l.ifname == "lo" else "" }}
{%   endif %}
{%   if 'ipv6' in l and l.ipv6 is string %}
 ipv6 address {{ l.ipv6 }}
{%   endif %}
{%   if l.type|default("") != "loopback" and not l.virtual_interface|default(False) %}
 {{ "shutdown" if l.shutdown|default(False) else "no shutdown" }}
{%   endif %}
!
{% endfor %}

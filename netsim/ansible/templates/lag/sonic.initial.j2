#
# SONiC lag module init: create the config_db PortChannel(s) before the aggregate is addressed
# in the device initial template (create-before-address ordering). Pulled into initial config by
# extra_module_initial() -- the same per-module init-hook mechanism VyOS uses.
#
{% for l in netlab_interfaces|default([]) if l.type == 'lag' %}
if ip link show {{ l.ifname }} >/dev/null 2>&1; then
  echo {{ l.ifname }} already exists
else
  config portchannel add {{ l.ifname }}
fi
{% endfor %}

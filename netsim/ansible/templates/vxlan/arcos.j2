{#
  ArcOS VXLAN. VTEP = `overlay local-tunnel-endpoint 0 source-interface loopback0`;
  per-VLAN VNI lives on the auto-created L2VLAN network-instance:
  `network-instance vlan<id> vni <vni> local-tunnel-endpoint-id 0`. The LTEP is committed
  separately (#COMMIT) before the VNIs reference it.
#}
overlay local-tunnel-endpoint 0 source-interface {{ vxlan.vtep_interface|default('loopback0') }}
#COMMIT
{% for vname in vxlan.vlans|default([]) %}
network-instance vlan{{ vlans[vname].id }} vni {{ vlans[vname].vni }} local-tunnel-endpoint-id 0
{% endfor %}

{# description: Lab address pools #}
{% import 'address-pools-utils.include.j2' as pcode %}
{% set pools = [] %}
{{- pcode.pool_list(addressing,pools) -}}
{% set cols = [] %}
{{- pcode.used_columns(pools,cols) -}}
{% for p_name,p_data in pools %}
{%   if loop.first %}
| Pool |{% for col in cols %} {{ pcode.columns[col] }} |{% endfor +%}
|------|{% for col in cols %}{{ "-" * (pcode.columns[col]|length + 1) }}{{ ':' if col in pcode.right_aligned else '-' }}|{% endfor +%}
{%   endif %}
| **{{ p_name }}** |{% for col in cols %} {{ pcode.cell(p_data,col) }} |{% endfor +%}
{% else %}
Your lab has no address pools.
{% endfor %}

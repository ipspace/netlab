{# description: MPLS LDP interfaces #}
{% for n_name,n_data in nodes|dictsort if 'ldp' in n_data %}
{%   if loop.first %}
<table>
  <thead>
    <tr>
      <th>Node</th>
      <th>Interface</th>
      <th>VRF</th>
      <th>Enabled</th>
      <th>Passive</th>
      <th>Description</th>
    </tr>
  </thead>
  <tbody>
{%   endif %}
{%   for intf in n_data.interfaces if 'ipv4' in intf %}
    <tr>
      <td><b>{{ n_name if loop.first else '' }}</b></td>
      <td>{{ intf.ifname }}</td>
      <td>{{ intf.vrf|default('') }}</td>
      <td>{{ 'yes' if 'ldp' in intf else 'no' }}</td>
      <td>{{ ('yes' if intf.ldp.passive else 'no') if 'ldp' in intf else '' }}</td>
      <td>{{ intf.name|default('') }}</td>
    </tr>
{%   endfor %}
{%   if loop.last %}
  </tbody>
</table>
{%   endif %}
{% else %}
Your network is not running MPLS LDP.
{% endfor %}

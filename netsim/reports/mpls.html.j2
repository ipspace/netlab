{# description: MPLS features (LDP, SR-MPLS, BGP-LU, L3VPN, 6PE) used on lab nodes #}
{% import 'mpls-utils.include.j2' as mcode %}
{% set node_list = [] %}
{{- mcode.mpls_nodes(nodes,node_list) -}}
{% set cols = [] %}
{{- mcode.used_columns(node_list,cols) -}}
{% for n_data in node_list %}
{%   if loop.first %}
<table>
  <thead>
    <tr>
      <th>Node</th>
{%     for col in cols %}
      <th>{{ mcode.columns[col] }}</th>
{%     endfor %}
    </tr>
  </thead>
  <tbody>
{%   endif %}
    <tr>
      <td><b>{{ n_data.name }}</b></td>
{%   for col in cols %}
      <td>{{ mcode.cell(n_data,col) }}</td>
{%   endfor %}
    </tr>
{%   if loop.last %}
  </tbody>
</table>
{%   endif %}
{% else %}
Your network is not running MPLS.
{% endfor %}

{# description: Lab address pools #}
{% import 'address-pools-utils.include.j2' as pcode %}
{% set pools = [] %}
{{- pcode.pool_list(addressing,pools) -}}
{% set cols = [] %}
{{- pcode.used_columns(pools,cols) -}}
{% for p_name,p_data in pools %}
{%   if loop.first %}
<table>
  <thead>
    <tr>
      <th>Pool</th>
{%     for col in cols %}
      <th{{ " class='right'" if col in pcode.right_aligned else '' }}>{{ pcode.columns[col] }}</th>
{%     endfor %}
    </tr>
  </thead>
  <tbody>
{%   endif %}
    <tr>
      <td><b>{{ p_name }}</b></td>
{%   for col in cols %}
      <td{{ " class='right'" if col in pcode.right_aligned else '' }}>{{ pcode.cell(p_data,col) }}</td>
{%   endfor %}
    </tr>
{%   if loop.last %}
  </tbody>
</table>
{%   endif %}
{% else %}
Your lab has no address pools.
{% endfor %}

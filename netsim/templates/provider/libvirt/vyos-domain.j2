    {{ name }}.vm.guest = :linux
    {{ name }}.vm.synced_folder ".", "/vagrant", id: "vagrant-root", disabled: true

    {{ name }}.ssh.insert_key = false
    {{ name }}.ssh.username = "{{ n.ansible_user }}"
    {{ name }}.ssh.password = "{{ n.ansible_ssh_pass }}"

    {{ name }}.vm.provider :libvirt do |domain|
      domain.cpus = 2
      domain.memory = 1024
    end

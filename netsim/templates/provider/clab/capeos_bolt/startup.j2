hostname {{ inventory_hostname.replace('_','-') }}
!
username {{ ansible_user }} privilege 15 secret {{ ansible_ssh_pass }}
!
ip ssh version 2
ip scp server enable
!
vrf definition clab-mgmt
 address-family ipv4
 exit-address-family
!
interface {{ mgmt.ifname }}
 description management
 vrf forwarding clab-mgmt
 ip address dhcp
!
line con 0
 logging synchronous
line vty 0 4
 login local
 transport input ssh
!
end
